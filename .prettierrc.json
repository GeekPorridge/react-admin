{
  "trailingComma": "all",
  "tabWidth": 2,
  "semi": false,
  "singleQuote": true,
  "importOrder": [
    "^@core/(.*)$",
    "^@server/(.*)$",
    "^@ui/(.*)$",
    "^[./]",
    "^@fullcalendar/react/dist/vdom$",
    "^@fullcalendar/react$",
    "^@fullcalendar/(.*)$"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true
}